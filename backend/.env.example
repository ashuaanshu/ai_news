# Groq uses an OpenAI-compatible API. Add your Groq API key from console.groq.com.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# For a local model instead, set AI_BASE_URL to its local /v1 endpoint and
# AI_MODEL to a model served locally.

# Comma-separated RSS/Atom URLs.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/technology/rss.xml,https://www.theguardian.com/technology/rss,https://techcrunch.com/feed/,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml,https://www.technologyreview.com/topic/artificial-intelligence/feed/
NEWS_MAX_ITEMS_PER_FEED=30

# Stock and market news RSS/Atom feeds.
STOCK_NEWS_FEEDS=https://feeds.marketwatch.com/marketwatch/marketpulse/

# India-focused market news. The default searches Google News for NSE, BSE, Nifty, and Sensex.
INDIAN_STOCK_NEWS_FEEDS=https://news.google.com/rss/search?q=NSE+OR+BSE+OR+Nifty+OR+Sensex&hl=en-IN&gl=IN&ceid=IN:en
